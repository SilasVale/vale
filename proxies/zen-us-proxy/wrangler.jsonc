{
  "name": "zen-us-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  // 2026-08-26: custom_domains is ignored by wrangler 4 and was never bound
  // in the dashboard; the domain in practice returned 000.
  // Switched to an explicit zone route (when the API token has Workers Routes
  // write access, this field takes effect on deploy).
  "routes": [
    { "pattern": "zen-us.saisi.online/*", "zone_id": "79860b60a8681147d0ce38294d404ead" }
  ],
  // smart placement (same as zen-go-proxy): move execution toward the
  // upstream (opencode.ai/zen/go). For /v1/responses (muse-spark) this can
  // place the worker on a US edge — Meta's geographic policy only allows
  // permitted regions, and an EU/Asia egress returns 403 RegionError from
  // zen (observed with the plain D1-pinned EU edge on 2026-09-05).
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "us-proxy-db",
      "database_id": "84148dae-6038-44bc-8a14-ed7391edc3e3"
    }
  ]
}
