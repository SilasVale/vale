{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && NODE_ENV=production vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "smoke": "node render-smoke.mjs ../public/assets/$(grep -o 'index-[^\"]*\\.js' ../public/index.html | head -1)",
    "smoke:devices": "node devices-render-smoke.mjs ../public/assets/$(grep -o 'index-[^\"]*\\.js' ../public/index.html | head -1)"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}