#!/usr/bin/env node
// vale — switch ~/.claude/settings.json between vale-gate channels.
// Zero-dependency Node.js (fs/os/path/fetch only). Install from the gateway
// console: `curl -fsSL https://api.saisi.online/api/vale-install | sh`
// (POSIX) or `irm https://api.saisi.online/api/vale-install.ps1 | iex` (Win).
"use strict";
const fs = require("fs");
const os = require("os");
const path = require("path");

const GATEWAY_BASE = "https://api.saisi.online";
const CHANNELS = {
  ds: { model: "ds/deepseek-v4-flash" },
  qw: { model: "qw/qwen3.8-max-preview" },
  og: { model: "og/deepseek-v4-flash" },
  or: { model: "or/openai/gpt-5.6-luna:floor[1m]" },
};
const PRIORITY = ["qw", "ds", "og", "or"];
const MODEL_ENV_KEYS = [
  "ANTHROPIC_MODEL",
  "ANTHROPIC_SMALL_FAST_MODEL",
  "ANTHROPIC_DEFAULT_SONNET_MODEL",
  "ANTHROPIC_DEFAULT_OPUS_MODEL",
  "ANTHROPIC_DEFAULT_HAIKU_MODEL",
  "ANTHROPIC_DEFAULT_MODEL",
  "CLAUDE_CODE_SUBAGENT_MODEL",
];
const KEEP_BACKUPS = 5;
const PROBE_TIMEOUT_MS = 20000;

function settingsFile() {
  return process.env.VALE_SETTINGS || path.join(os.homedir(), ".claude", "settings.json");
}
function readSettings() {
  try {
    return JSON.parse(fs.readFileSync(settingsFile(), "utf8"));
  } catch (e) {
    console.error(`无法读取 ${settingsFile()}: ${e.message}`);
    process.exit(1);
  }
}
function writeAtomic(data) {
  const file = settingsFile();
  const mode = fs.existsSync(file) ? fs.statSync(file).mode & 0o777 : 0o600;
  const tmp = `${file}.tmp-${process.pid}`;
  fs.writeFileSync(tmp, JSON.stringify(data, null, 2) + "\n", { encoding: "utf8", mode });
  fs.renameSync(tmp, file);
}
// Atomically install an existing file over settingsFile: copy to a tmp file
// (mode preserved), then rename over the target. A direct copyFileSync over
// settings.json would leave it truncated if the process died mid-copy.
function installFile(src) {
  const file = settingsFile();
  const mode = fs.existsSync(file) ? fs.statSync(file).mode & 0o777 : 0o600;
  const tmp = `${file}.tmp-${process.pid}`;
  fs.copyFileSync(src, tmp);
  fs.chmodSync(tmp, mode);
  fs.renameSync(tmp, file);
}
// The vale CLI manages the switch TO the gateway, so it always talks to the
// gateway base — NOT the settings.json ANTHROPIC_BASE_URL (which may still
// point at a direct provider). VALE_GATEWAY overrides for tests.
function gatewayBase() {
  return process.env.VALE_GATEWAY || GATEWAY_BASE;
}
function authToken(settings) {
  const env = settings.env || {};
  return env.ANTHROPIC_API_KEY || env.ANTHROPIC_AUTH_TOKEN || "";
}
function currentChannel(settings) {
  const model = (settings.env && settings.env.ANTHROPIC_MODEL) || "";
  for (const [id, ch] of Object.entries(CHANNELS)) {
    if (model === ch.model) return id;
  }
  for (const id of Object.keys(CHANNELS)) {
    if (model.startsWith(id + "/")) return id;
  }
  return null;
}
function backup() {
  const file = settingsFile();
  const stamp = new Date().toISOString().replace(/[:.]/g, "-");
  const bak = `${file}.bak-vale-${stamp}`;
  fs.copyFileSync(file, bak);
  const dir = path.dirname(file);
  const base = path.basename(file);
  const olds = fs.readdirSync(dir)
    .filter((f) => f.startsWith(`${base}.bak-vale-`))
    .sort()
    .reverse();
  for (const f of olds.slice(KEEP_BACKUPS)) fs.unlinkSync(path.join(dir, f));
  return bak;
}
function findBackup() {
  const file = settingsFile();
  const dir = path.dirname(file);
  const base = path.basename(file);
  const list = fs.readdirSync(dir)
    .filter((f) => f.startsWith(`${base}.bak-vale-`))
    .sort()
    .reverse();
  return list.length ? path.join(dir, list[0]) : null;
}

/* ---- Provider store (~/.vale/providers.json) ----
 * Like cc-switch: named providers each carry a full connection config
 * (base URL + token + model). `vale use <provider>` switches the whole env
 * block (base/token/model), so any provider — gateway channel or direct
 * API — is one command away. File mode 0600; tokens never printed. */
function providersFile() {
  return process.env.VALE_PROVIDERS || path.join(os.homedir(), ".vale", "providers.json");
}
function readProviders() {
  try {
    const p = JSON.parse(fs.readFileSync(providersFile(), "utf8"));
    return p && typeof p === "object" ? p : {};
  } catch { return {}; }
}
function writeProviders(providers) {
  const file = providersFile();
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const tmp = `${file}.tmp-${process.pid}`;
  fs.writeFileSync(tmp, JSON.stringify(providers, null, 2) + "\n", { encoding: "utf8", mode: 0o600 });
  fs.renameSync(tmp, file);
}
function maskKey(key) {
  if (!key) return "";
  if (key.length <= 8) return "***";
  return key.slice(0, 3) + "***" + key.slice(-3);
}
function parseFlags(argv) {
  const out = {};
  for (let i = 0; i < argv.length; i++) {
    if (String(argv[i]).startsWith("--")) out[argv[i].slice(2)] = argv[i + 1];
  }
  return out;
}
async function cmdProviderAdd(name, opts) {
  if (!name || !opts.base || !opts.token || !opts.model) {
    console.error("用法: vale provider add <名称> --base <URL> --token <TOKEN> --model <模型>");
    process.exit(1);
  }
  const providers = readProviders();
  providers[name] = { base: opts.base, token: opts.token, model: opts.model };
  writeProviders(providers);
  console.log(`已添加提供商 ${name} → ${opts.base}（${opts.model}）`);
  // Probe both auth styles so `vale use` writes the right env variable.
  const auth = await detectAuth(opts.base, opts.token, opts.model);
  if (auth) {
    providers[name].auth = auth;
    writeProviders(providers);
    console.log(`鉴权: ${auth === "bearer" ? "Bearer → ANTHROPIC_AUTH_TOKEN" : "x-api-key → ANTHROPIC_API_KEY"}`);
  } else {
    console.log("⚠️ 两种鉴权探测都未通过 —— 已保存，vale use 时会再次验证");
  }
}
function cmdProviderList() {
  const providers = readProviders();
  const names = Object.keys(providers);
  if (!names.length) {
    console.log("（无提供商，用 vale provider add 添加）");
    return;
  }
  for (const n of names) {
    const p = providers[n];
    const auth = p.auth === "bearer" ? "Bearer" : p.auth === "api-key" ? "x-api-key" : "双写(未探测)";
    console.log(`  ${n} → ${p.base}  model: ${p.model}  auth: ${auth}  token: ${maskKey(p.token)}`);
  }
  console.log("用法: vale use <提供商名>");
}
function cmdProviderRm(name) {
  const providers = readProviders();
  if (!providers[name]) {
    console.error(`提供商不存在: ${name}`);
    process.exit(1);
  }
  delete providers[name];
  writeProviders(providers);
  console.log(`已删除提供商 ${name}`);
}
// Which auth header a provider accepts: some gateways only read x-api-key
// (ANTHROPIC_API_KEY), official Anthropic-compatible endpoints prefer
// Authorization: Bearer (ANTHROPIC_AUTH_TOKEN). detectAuth() finds the one
// that works so the user never has to care.
function probeHeaders(auth, token) {
  if (auth === "api-key") return { "x-api-key": token };
  if (auth === "bearer") return { Authorization: `Bearer ${token}` };
  return { "x-api-key": token, Authorization: `Bearer ${token}` }; // legacy/unknown
}
// Generic probe for any provider base: fire a real max_tokens=1 request with
// that provider's own token (works for the gateway AND direct APIs).
async function probeTarget(base, token, model, auth) {
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), PROBE_TIMEOUT_MS);
  try {
    const r = await fetch(`${base}/v1/messages`, {
      method: "POST",
      headers: { ...probeHeaders(auth, token), "content-type": "application/json", "anthropic-version": "2023-06-01" },
      body: JSON.stringify({ model, max_tokens: 1, messages: [{ role: "user", content: "ping" }] }),
      signal: ctrl.signal,
    });
    return r.status === 200;
  } catch { return false; } finally { clearTimeout(t); }
}
// Auto-detect the auth header a provider accepts. Bearer first (the official
// Anthropic-compatible convention), then x-api-key (gateway-style). Returns
// "bearer" | "api-key" | null (null = neither worked).
async function detectAuth(base, token, model) {
  if (await probeTarget(base, token, model, "bearer")) return "bearer";
  if (await probeTarget(base, token, model, "api-key")) return "api-key";
  return null;
}
// Provider switch: replace the whole env block (base + token + model). The
// token goes into the env variable matching the provider's detected auth
// style — x-api-key gateways get ANTHROPIC_API_KEY, Bearer endpoints get
// ANTHROPIC_AUTH_TOKEN — and the other one is cleared so a stale header
// never lingers. Legacy providers without an auth field keep the old
// dual-write for compatibility.
async function cmdUseProvider(name, settings) {
  const p = readProviders()[name];
  if (!p || !p.base || !p.token || !p.model) {
    console.error(`提供商不存在或配置不完整: ${name}`);
    process.exit(1);
  }
  if (!(await probeTarget(p.base, p.token, p.model, p.auth || ""))) {
    console.error(`探测失败: ${p.base} 上的 ${p.model} 不可用，未切换`);
    process.exit(1);
  }
  const env = settings.env || {};
  for (const k of MODEL_ENV_KEYS) env[k] = p.model;
  env.ANTHROPIC_BASE_URL = p.base;
  if (p.auth === "api-key") {
    env.ANTHROPIC_API_KEY = p.token;
    delete env.ANTHROPIC_AUTH_TOKEN;
  } else if (p.auth === "bearer") {
    env.ANTHROPIC_AUTH_TOKEN = p.token;
    delete env.ANTHROPIC_API_KEY;
  } else {
    // legacy provider (no auth detected): dual-write, works with both styles
    env.ANTHROPIC_API_KEY = p.token;
    env.ANTHROPIC_AUTH_TOKEN = p.token;
  }
  settings.env = env;
  const bak = backup();
  writeAtomic(settings);
  console.log(`已切换到提供商 ${name}（${p.model} @ ${p.base}）`);
  console.log(`备份: ${bak}`);
  console.log("重启 Claude Code 后生效");
}
function switchEnv(settings, model) {
  const env = settings.env || {};
  for (const k of MODEL_ENV_KEYS) env[k] = model;
  env.ANTHROPIC_BASE_URL = GATEWAY_BASE;
  settings.env = env;
  return settings;
}
async function fetchHealth() {
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), PROBE_TIMEOUT_MS);
  try {
    const r = await fetch(`${gatewayBase()}/api/health`, { signal: ctrl.signal });
    if (!r.ok) return null;
    return await r.json();
  } catch { return null; } finally { clearTimeout(t); }
}
// Channel probe via the gateway's public /api/vale-probe (the gateway fires
// the real max_tokens=1 request with its own provider keys — no client token
// needed, works from any settings state).
async function probeChannel(model) {
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), PROBE_TIMEOUT_MS);
  try {
    const r = await fetch(`${gatewayBase()}/api/vale-probe`, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ model }),
      signal: ctrl.signal,
    });
    if (!r.ok) return false;
    const j = await r.json();
    return j.ok === true;
  } catch { return false; } finally { clearTimeout(t); }
}
// The settings token must be the gateway's x-api-key AFTER the switch, or
// Claude Code gets 401. Verify against a cheap authenticated endpoint.
async function tokenValid(token) {
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), PROBE_TIMEOUT_MS);
  try {
    const r = await fetch(`${gatewayBase()}/v1/models`, {
      headers: { "x-api-key": token },
      signal: ctrl.signal,
    });
    return r.status === 200;
  } catch { return false; } finally { clearTimeout(t); }
}
// Full model list from the gateway (also validates the token).
async function listModels(token) {
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), PROBE_TIMEOUT_MS);
  try {
    const r = await fetch(`${gatewayBase()}/v1/models`, {
      headers: { "x-api-key": token },
      signal: ctrl.signal,
    });
    if (r.status !== 200) return null;
    const j = await r.json();
    return (j.data || []).map((m) => m.id).filter((id) => typeof id === "string");
  } catch { return null; } finally { clearTimeout(t); }
}
// `use <arg>`: a channel name resolves to its default model; anything else
// must be a full model id present in the gateway's whitelist.
function resolveModel(arg, models) {
  if (CHANNELS[arg]) return CHANNELS[arg].model;
  if ((models || []).includes(arg)) return arg;
  return null;
}
function pickRecommended(channels) {
  for (const id of PRIORITY) {
    const c = (channels || []).find((x) => x.id === id);
    if (c && c.ok) return c;
  }
  return null;
}

async function cmdCheck() {
  const settings = readSettings();
  const cur = currentChannel(settings);
  const health = await fetchHealth();
  console.log(`网关: ${gatewayBase()}`);
  if (!health || !Array.isArray(health.channels)) {
    console.error("无法获取渠道健康（/api/health 不可达）");
    process.exit(1);
  }
  for (const c of health.channels) {
    const marker = c.ok ? "✅ 正常" : `⚠️  ${c.reason || "异常"}`;
    const curMark = c.id === cur ? "  ← 当前" : "";
    console.log(`  ${c.id}/ → ${c.model}  ${marker}${curMark}`);
  }
  const rec = pickRecommended(health.channels);
  console.log(rec ? `推荐: ${rec.model}` : "推荐: 无可用渠道");
  if (cur) console.log(`当前配置: ${cur}（${(settings.env || {}).ANTHROPIC_MODEL}）`);
}

async function cmdModels() {
  const settings = readSettings();
  const token = authToken(settings);
  if (!token || !(await tokenValid(token))) {
    console.error("settings.json 里的 token 对网关无效 —— 请在 console 的密钥管理获取网关 token，更新 ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN 后重试");
    process.exit(1);
  }
  const models = await listModels(token);
  if (!models) {
    console.error("无法获取模型列表（/v1/models 不可达）");
    process.exit(1);
  }
  const byPrefix = {};
  for (const m of models) {
    const p = m.split("/")[0];
    (byPrefix[p] = byPrefix[p] || []).push(m);
  }
  for (const [p, ms] of Object.entries(byPrefix)) {
    console.log(`  ${p}/ → ${ms.join(", ")}`);
  }
  console.log(`用法: vale use <${Object.keys(CHANNELS).join("|")}|完整模型名>`);
}

async function cmdUse(arg) {
  const settings = readSettings();
  // Provider names resolve first (they carry their own base/token/model).
  if (readProviders()[arg]) return cmdUseProvider(arg, settings);
  const token = authToken(settings);
  if (!token || !(await tokenValid(token))) {
    console.error("settings.json 里的 token 对网关无效 —— 请在 console 的密钥管理获取网关 token，更新 ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN 后重试");
    process.exit(1);
  }
  const models = await listModels(token);
  const model = resolveModel(arg, models);
  if (!model) {
    console.error(`未知渠道/模型: ${arg}（渠道: ${Object.keys(CHANNELS).join(" / ")}；完整模型: 用 \`vale models\` 查看）`);
    process.exit(1);
  }
  const ok = await probeChannel(model);
  if (!ok) {
    console.error(`探测失败: ${model} 不可用，未切换`);
    process.exit(1);
  }
  const bak = backup();
  switchEnv(settings, model);
  writeAtomic(settings);
  console.log(`已切换到 ${model}`);
  console.log(`备份: ${bak}`);
  console.log("重启 Claude Code 后生效");
}

async function cmdAuto() {
  const settings = readSettings();
  const token = authToken(settings);
  if (!token || !(await tokenValid(token))) {
    console.error("settings.json 里的 token 对网关无效 —— 请在 console 的密钥管理获取网关 token，更新 ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN 后重试");
    process.exit(1);
  }
  const health = await fetchHealth();
  const channels = health && Array.isArray(health.channels) ? health.channels : [];
  // Probe each in priority order: switch to the first healthy channel whose probe passes; exit with an error if all fail.
  for (const id of PRIORITY) {
    const c = channels.find((x) => x.id === id);
    if (!c || !c.ok) continue;
    if (await probeChannel(c.model)) {
      const bak = backup();
      switchEnv(settings, c.model);
      writeAtomic(settings);
      console.log(`已自动切换到 ${c.model}（${c.id}）`);
      console.log(`备份: ${bak}`);
      console.log("重启 Claude Code 后生效");
      return;
    }
    console.error(`渠道 ${c.id} 探测失败，尝试下一个…`);
  }
  console.error("无可用渠道，未切换");
  process.exit(1);
}

function cmdRestore() {
  // findBackup must run before backup: backup creates a new backup of the current state.
  const bak = findBackup();
  if (!bak) {
    console.error("没有可恢复的备份");
    process.exit(1);
  }
  backup(); // back up the current state before restoring (same as use: keep a snapshot before every change)
  installFile(bak); // tmp + rename atomic restore, permission bits preserved
  console.log(`已恢复 ${bak}`);
  console.log("重启 Claude Code 后生效");
}

async function main() {
  const args = process.argv.slice(2);
  const cmd = args[0] || "check";
  if (cmd === "check") return cmdCheck();
  if (cmd === "models") return cmdModels();
  if (cmd === "provider") {
    const sub = args[1];
    if (sub === "add") return cmdProviderAdd(args[2], parseFlags(args.slice(3)));
    if (sub === "list") return cmdProviderList();
    if (sub === "rm") return cmdProviderRm(args[2]);
    console.error("用法: vale provider add <名称> --base <URL> --token <TOKEN> --model <模型> | provider list | provider rm <名称>");
    process.exit(1);
  }
  if (cmd === "use") return args[1] === "auto" ? cmdAuto() : cmdUse(args[1]);
  if (cmd === "restore") return cmdRestore();
  console.error(`用法: vale check | vale models | vale use <ds|qw|og|or|模型名|提供商名|auto> | vale provider add|list|rm | vale restore`);
  process.exit(1);
}

main().catch((e) => { console.error(e.message); process.exit(1); });
